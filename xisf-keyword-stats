#!/usr/bin/python3
import argparse
import glob
import json
import math
import os
from statistics import mean, median

from xisf import XISF
from yaml import dump, Dumper

parser = argparse.ArgumentParser(description='XISF keyword statistics')
parser.add_argument('files', nargs='+')
parser.add_argument(
    '-r',
    '--recursive',
    action='store_true',
    help='Treat file inputs as glob patterns and search subdirectories',
)
parser.add_argument(
    '-e',
    '--exclude',
    action='append',
    metavar='PATTERN',
    help='Exclude matching files when searching recursively (may be repeated)',
)
keyword_group = parser.add_mutually_exclusive_group(required=True)
keyword_group.add_argument(
    '-k', '--keyword', help='FITS keyword whose numeric values to analyze'
)
keyword_group.add_argument(
    '-t',
    '--temperature',
    action='store_const',
    const='CCD-TEMP',
    dest='keyword',
    help='Analyze the CCD-TEMP keyword',
)
parser.add_argument(
    '-b',
    '--bins',
    type=int,
    default=10,
    help='Number of histogram bins (default: 10)',
)
parser.add_argument(
    '--show-empty-bins',
    action='store_true',
    help='Include histogram bins with no files',
)
parser.add_argument('-y', '--yaml', action='store_true')
args = parser.parse_args()


def expand_recursive_patterns(patterns, require_matches=True):
    files = []
    for pattern in patterns:
        directory, filename = os.path.split(pattern)
        recursive_pattern = os.path.join(directory, '**', filename)
        matches = sorted(
            path
            for path in glob.glob(recursive_pattern, recursive=True)
            if os.path.isfile(path)
        )
        if require_matches and not matches:
            parser.error(f'{pattern}: recursive glob matched no files')
        files.extend(matches)
    return files


if args.exclude and not args.recursive:
    parser.error('--exclude requires --recursive')
if args.recursive:
    args.files = expand_recursive_patterns(args.files)
    excluded = {
        os.path.abspath(filename)
        for filename in expand_recursive_patterns(args.exclude or [], False)
    }
    args.files = [
        filename
        for filename in args.files
        if os.path.abspath(filename) not in excluded
    ]
    if not args.files:
        parser.error('No files remain after applying exclusions')

if args.bins < 1:
    parser.error('--bins must be at least 1')

minimum = None
maximum = None
values = []

for filename in args.files:
    file = XISF(filename)
    ims_meta = file.get_images_metadata()
    try:
        value = float(ims_meta[0]['FITSKeywords'][args.keyword][0]['value'])
    except (IndexError, KeyError, TypeError, ValueError) as error:
        parser.error(
            f'{filename}: could not read a numeric value for keyword '
            f'{args.keyword}: {error}'
        )
    if not math.isfinite(value):
        parser.error(
            f'{filename}: keyword {args.keyword} must have a finite numeric value'
        )
    values.append(value)
    if minimum is None or minimum['value'] > value:
        minimum = {'filename': filename, 'value': value}
    if maximum is None or maximum['value'] < value:
        maximum = {'filename': filename, 'value': value}


def build_histogram(data, bin_count, show_empty_bins):
    low = min(data)
    high = max(data)
    if low == high:
        return [{'minimum': low, 'maximum': high, 'count': len(data)}]

    width = (high - low) / bin_count
    counts = [0] * bin_count
    for value in data:
        index = min(int((value - low) / width), bin_count - 1)
        counts[index] += 1

    histogram = [
        {
            'minimum': low + index * width,
            'maximum': low + (index + 1) * width,
            'count': count,
        }
        for index, count in enumerate(counts)
    ]
    if show_empty_bins:
        return histogram
    return [bin for bin in histogram if bin['count']]


out = {
        'keyword': args.keyword,
        'minimum': minimum,
        'maximum': maximum,
        'mean': mean(values),
        'median': median(values),
        'histogram': build_histogram(values, args.bins, args.show_empty_bins),
}

if args.yaml:
    print(dump(out, Dumper=Dumper, sort_keys=False))
else:
    print(json.dumps(out, indent=4, default=str))


                       
